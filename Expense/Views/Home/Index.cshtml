@model List<Transaction>

@{
    ViewData["Title"] = "Expense Manager - Home";
    decimal totalIncome = Model.Where(t => t.Type == "Income").Sum(t => t.Amount);
    decimal totalExpense = Model.Where(t => t.Type == "Expense").Sum(t => t.Amount);
    decimal balance = totalIncome - totalExpense;
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Expense Manager</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="bg-light">

<div class="container py-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">💰 Expense Manager</h2>
        <form method="get" asp-action="AddTransaction" asp-controller="Transaction">
            <button type="submit" class="btn btn-primary">+ Add Transaction</button>
        </form>
        
    </div>

    <!-- Summary Cards -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card shadow-sm border-success">
                <div class="card-body">
                    <h6 class="text-success">Income</h6>
                    <h3>@totalIncome.ToString("C")</h3>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm border-danger">
                <div class="card-body">
                    <h6 class="text-danger">Expense</h6>
                    <h3>@totalExpense.ToString("C")</h3>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm border-primary">
                <div class="card-body">
                    <h6 class="text-primary">Balance</h6>
                    <h3>@balance.ToString("C")</h3>
                </div>
            </div>
        </div>
    </div>

    <!-- Transactions Table -->
    <div class="card shadow-sm">
        <div class="card-header bg-white">
            <h5 class="mb-0">Recent Transactions</h5>
        </div>

        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Name</th>
                        <th>Category</th>
                        <th>Type</th>
                        <th>Date</th>
                        <th>Note</th>
                        <th class="text-end">Value</th>
                    </tr>
                </thead>

                <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Name</td>
                            <td>@item.Category.Name</td>

                            <td>
                                @if (item.Type == "Income")
                                {
                                    <span class="badge bg-success">Income</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Expense</span>
                                }
                            </td>

                            <td>@item.Date.ToString("dd MMM yyyy")</td>
                            <td>@item.Note</td>

                            <td class="text-end fw-bold @(item.Type == "Income" ? "text-success" : "text-danger")">
                                @item.Amount.ToString("0.00")
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">
                            No transactions found
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>

</div>

</body>
</html>