@model Expense.ViewModels.TransactionViewModel

@{
    ViewData["Title"] = "Add Transaction";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Add Transaction</title>
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="bg-light">

<div class="container py-5">

    <!-- Header -->
    <div class="mb-4">
        <h2 class="fw-bold">➕ Add Transaction</h2>
        <p class="text-muted">Record your income or expense</p>
    </div>

    <!-- Form Card -->
    <div class="card shadow-sm">
        <div class="card-body p-4">

            <form asp-action="AddTransaction" method="post">

                <div class="row">

                    <!-- Name -->
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Transaction Name</label>
                        <input asp-for="Name" class="form-control" placeholder="e.g. Salary, Rent, Food" />
                    </div>

                    <!-- Value -->
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Amount</label>
                        <input asp-for="Amount" type="number" step="0.01" class="form-control" placeholder="Enter amount" />
                    </div>

                    <!-- Type -->
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Type</label>
                        <select asp-for="Type" class="form-select">
                            <option value="">-- Select Type --</option>
                            <option value="Income">Income</option>
                            <option value="Expense">Expense</option>
                        </select>
                    </div>

                    <!-- Category -->
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Category</label>
                        <select asp-for="CategoryName" class="form-select">
                            <option value="">-- Select Type --</option>
                            <option value="Food">Food</option>
                            <option value="Travel">Travel</option>
                            <option value="Bill Payment">Bill Payment</option>
                            <option value="Education">Education</option>
                            <option value="Daily">Daily</option>
                        </select>
                    </div>

                    <!-- Note -->
                    <div class="col-md-12 mb-3">
                        <label class="form-label">Note</label>
                        <textarea asp-for="Note" class="form-control" rows="3"
                                  placeholder="Optional details..."></textarea>
                    </div>

                </div>

                <!-- Buttons -->
                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" asp-controller="Home" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-success">Save Transaction</button>
                </div>

            </form>

        </div>
    </div>

</div>

</body>
</html>